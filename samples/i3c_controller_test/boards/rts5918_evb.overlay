/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Point the generic "i3c-controller-0" alias at this board's controller-mode
 * I3C instance. Change the phandle to match the instance you configured as a
 * controller in the board .dts.
 *
 * For Hot Join / IBI to surface a target at the Zephyr level, the expected
 * target(s) must be declared as child nodes of that controller node (with
 * their PID via reg), e.g.:
 *
 *   &i3c4 {
 *       status = "okay";
 *       ...
 *       some_target: target@3100... {
 *           compatible = "realtek,rts5918-i3c-target";
 *           reg = <0x31 0x04ba 0x00001004>;
 *           assigned-address = <0x09>;
 *       };
 *   };
 */

/ {
	aliases {
		i3c-controller-0 = &i3c4;
	};
};

/*
 * Declare the expected target(s) under the controller node. Following the
 * Zephyr design, a target must be declared here (matched by PID) so that when
 * it hot-joins, the ENTDAA'd dynamic address binds to its i3c_device_desc and
 * the app (auto-ENEC, IBI callback, transfers) can use it.
 *
 * reg = <static-addr  PID-msb  PID-lsb>. Adjust these to match the actual
 * target: its static address and 48-bit Provisioned ID (pid-msb/pid-lsb on the
 * target node).
 */
&i3c4 {
	/* Controller-mode config: the board .dts no longer enables i3c4, so this
	 * overlay brings it up as an I3C controller.
	 */
	status = "okay";
	pinctrl-0 = <&i3c04_scl_gpio014 &i3c04_sda_gpio017
		     &i3c04_scl_gpio014_pin_sel &i3c04_sda_gpio017_pin_sel>;
	pinctrl-names = "default";
	i3c-scl-hz = <4000000>;		/* I3C push-pull (PP): 4 MHz */
	i3c-od-scl-hz = <1000000>;	/* I3C open-drain (OD): 1 MHz */
	i2c-scl-hz = <400000>;
	primary-controller-da = <0x7c>;

	//SV6E
	/* PID 0xFFA4BA84CE07 -> pid-msb 0xFFA4, pid-lsb 0xBA84CE07.
	 * reg = <static-addr PID-msb PID-lsb>; static 0 = pure I3C (ENTDAA hot-join).
	 */
	 hj_target0: target@ffa4ba84ce07 {
	 	compatible = "realtek,rts5918-i3c-target";
	 	reg = <0x00 0xffa4 0xba84ce07>;
	 };

	// temperature sensor
	// /* PID 0x0236152A00AC -> pid-msb 0x0236, pid-lsb 0x152A00AC.
	//  */
	// hj_target1: target@236152a00ac {
	// 	compatible = "realtek,rts5918-i3c-target";
	// 	reg = <0x00 0x0236 0x152a00ac>;
	// };

	/* Legacy I2C device on the I3C bus. The middle reg cell (reg[1]) = 0 marks
	 * the node as I2C rather than I3C. reg = <i2c-addr  0x00  LVR>; LVR 0 = has
	 * 50 ns spike filter, FM+ mode.
	 */
	// i2c_dev0: target@640000000000000000 {
	// 	compatible = "realtek,rts5918-i3c-target";
	// 	reg = <0x64 0x00 0x00>;
	// };
};
