config WDT_RTS5918
	bool "Realtek RTS5918 Embedded Controller Watchdog Driver"
	default y
	depends on DT_HAS_REALTEK_RTS5918_WATCHDOG_ENABLED
	select HAS_WDT_DISABLE_AT_BOOT
	help
	  This option enables the WDT driver for Realtek RTS5918 family of
	  processors.
