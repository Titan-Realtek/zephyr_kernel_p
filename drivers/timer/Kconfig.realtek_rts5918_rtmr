config REALTEK_RTS5918_RTMR
	bool "Realtek RTS5918/RTS5918/RTS5918 RTOS Timer"
	depends on SOC_SERIES_RTS5918 || SOC_SERIES_RTS5918 || SOC_SERIES_RTS5918
	default y if DT_HAS_REALTEK_RTS5918_RTMR_ENABLED
	select TICKLESS_CAPABLE
	select SYSTEM_TIMER_HAS_DISABLE_SUPPORT
