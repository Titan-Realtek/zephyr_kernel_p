config UART_RTS5918
	bool "UART driver for Realtek RTS5918 EC"
	depends on SOC_SERIES_RTS5918
	default y if DT_HAS_REALTEK_RTS5918_UART_ENABLED
	select PINCTRL
	select CLOCK_CONTROL
	help
	  This option enables the RTS5918 UART wrapper driver.

config UART_RTS5918_INIT_PRIORITY
	int "RTS5918 UART wrapper init priority"
	default 51
	depends on UART_RTS5918
	help
	  Initialization priority for Realtek RTS5918 UART wrapper driver.
