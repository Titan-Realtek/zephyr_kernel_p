config COUNTER_REALTEK_RTS5918_SLWTMR
	bool "Realtek rts5918 series slow timer counter driver"
	default y
	depends on DT_HAS_REALTEK_RTS5918_SLWTIMER_ENABLED
	help
	  Enable counter driver for Realtek RTS5918 MCU series. Such driver
	  will expose the slow timer devices present on the MCU.
