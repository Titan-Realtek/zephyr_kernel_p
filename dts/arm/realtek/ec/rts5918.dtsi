		};

		pwm11: pwm@40254f00 {
			compatible = "realtek,rts5918-pwm";
			clocks = <&sccon RTS5918_CLK_LEDPWM RTS5918_PWM11_PWR>;
			clock-names = "pwm";
			reg = <0x40254f00 0x0c>;
			status = "disabled";
			#pwm-cells = <3>;
		};

		pwm12: pwm@40255000 {
			compatible = "realtek,rts5918-pwm";
			clocks = <&sccon RTS5918_CLK_LEDPWM RTS5918_PWM12_PWR>;
			clock-names = "pwm";
			reg = <0x40255000 0x0c>;
			status = "disabled";
			#pwm-cells = <3>;
		};

		pwmled1: pwm@40252d00 {
			compatible = "realtek,rts5918-pwm";
			clocks = <&sccon RTS5918_CLK_LEDPWM RTS5918_LED1_PWR>;
			clock-names = "pwm";
			reg = <0x40252d00 0x18>;
			status = "disabled";
			#pwm-cells = <3>;
			pwm-led;
		};

		pwmled2: pwm@40252e00 {
			compatible = "realtek,rts5918-pwm";
			clocks = <&sccon RTS5918_CLK_LEDPWM RTS5918_LED3_PWR>;
			clock-names = "pwm";
			reg = <0x40252e00 0x18>;
			status = "disabled";
			#pwm-cells = <3>;
			pwm-led;
		};

		pwmled3: pwm@40252f00 {
			compatible = "realtek,rts5918-pwm";
			clocks = <&sccon RTS5918_CLK_LEDPWM RTS5918_LED4_PWR>;
			clock-names = "pwm";
			reg = <0x40252f00 0x18>;
			status = "disabled";
			#pwm-cells = <3>;
			pwm-led;
		};

		pwmled4: pwm@40253000 {
			compatible = "realtek,rts5918-pwm";
			clocks = <&sccon RTS5918_CLK_LEDPWM RTS5918_LED2_PWR>;
			clock-names = "pwm";
			reg = <0x40253000 0x18>;
			status = "disabled";
			#pwm-cells = <3>;
			pwm-led;
		};

		/*
		 * Phase 10.6 — RTS5918 has 9 tachometer controllers per the
		 * datasheet (RL7088_SVD-master 3/RTS5918.h TACHOn_BASE +
		 * TACHOn_IRQn definitions). Each controller is 0x100 apart
		 * starting at 0x40251F00. IRQs are 82..90 sequentially. Clock
		 * bindings RTS5918_TACH1..9_PWR exist in the SCCON header.
		 *
		 * Pinctrl-0 used to be hardcoded on tach5 to gpio013 (an
		 * arbitrary choice that wasn't right for any board). Removed
		 * — pinctrl is a board-level concern. Boards that use a tach
		 * controller add it via `&tachN { pinctrl-0 = <...>; };`.
		 */
		tach1: tach@40251f00 {
			compatible = "realtek,rts5918-tach";
			reg = <0x40251f00 0x40>;
			clocks = <&sccon RTS5918_CLK_RC25M RTS5918_TACH1_PWR>;
			clock-names = "tacho";
			interrupts = <82 1>;
			interrupt-parent = <&nvic>;
			status = "disabled";
		};

		tach2: tach@40252000 {
			compatible = "realtek,rts5918-tach";
			reg = <0x40252000 0x40>;
			clocks = <&sccon RTS5918_CLK_RC25M RTS5918_TACH2_PWR>;
			clock-names = "tacho";
			interrupts = <83 1>;
			interrupt-parent = <&nvic>;
			status = "disabled";
		};

		tach3: tach@40252100 {
			compatible = "realtek,rts5918-tach";
			reg = <0x40252100 0x40>;
			clocks = <&sccon RTS5918_CLK_RC25M RTS5918_TACH3_PWR>;
			clock-names = "tacho";
			interrupts = <84 1>;
			interrupt-parent = <&nvic>;
			status = "disabled";
		};

		tach4: tach@40252200 {
			compatible = "realtek,rts5918-tach";
			reg = <0x40252200 0x40>;
			clocks = <&sccon RTS5918_CLK_RC25M RTS5918_TACH4_PWR>;
			clock-names = "tacho";
			interrupts = <85 1>;
			interrupt-parent = <&nvic>;
			status = "disabled";
		};

		tach5: tach@40252300 {
			compatible = "realtek,rts5918-tach";
			reg = <0x40252300 0x40>;
			clocks = <&sccon RTS5918_CLK_RC25M RTS5918_TACH5_PWR>;
			clock-names = "tacho";
			interrupts = <86 1>;
			interrupt-parent = <&nvic>;
			status = "disabled";
		};

		tach6: tach@40252400 {
			compatible = "realtek,rts5918-tach";
			reg = <0x40252400 0x40>;
			clocks = <&sccon RTS5918_CLK_RC25M RTS5918_TACH6_PWR>;
			clock-names = "tacho";
			interrupts = <87 1>;
			interrupt-parent = <&nvic>;
			status = "disabled";
		};

		tach7: tach@40252500 {
			compatible = "realtek,rts5918-tach";
			reg = <0x40252500 0x40>;
			clocks = <&sccon RTS5918_CLK_RC25M RTS5918_TACH7_PWR>;
			clock-names = "tacho";
			interrupts = <88 1>;
			interrupt-parent = <&nvic>;
			status = "disabled";
		};

		tach8: tach@40252600 {
			compatible = "realtek,rts5918-tach";
			reg = <0x40252600 0x40>;
			clocks = <&sccon RTS5918_CLK_RC25M RTS5918_TACH8_PWR>;
			clock-names = "tacho";
			interrupts = <89 1>;
			interrupt-parent = <&nvic>;
			status = "disabled";
		};

		tach9: tach@40252700 {
			compatible = "realtek,rts5918-tach";
			reg = <0x40252700 0x40>;
			clocks = <&sccon RTS5918_CLK_RC25M RTS5918_TACH9_PWR>;
			clock-names = "tacho";
			interrupts = <90 1>;
			interrupt-parent = <&nvic>;
			status = "disabled";
		};

		rtc: rtc@40253c00 {
			compatible = "realtek,rts5918-rtc";
			reg = <0x40253c00 0x20>;
			clocks = <&sccon RTS5918_CLK_APB RTS5918_RTC_PWR>;
			clock-names = "rtc";
			interrupt-parent = <&nvic>;
			interrupts = <107 2>;
			status = "disabled";
		};

		wdog: watchdog@40253f00 {
			compatible = "realtek,rts5918-watchdog";
			reg = <0x40253f00 0x014>;
			interrupt-parent = <&nvic>;
			interrupts = <114 1>;
			clocks = <&sccon RTS5918_CLK_APB RTS5918_WDT_PWR>;
			clock-names = "watchdog";
			clk-divider = <33>;
			status = "disabled";
		};

		kbd: kbd@40254200 {
			compatible = "realtek,rts5918-kbd";
			reg = <0x40254200 0x30>;
			clocks = <&sccon RTS5918_CLK_RC25M RTS5918_KBM_PWR >;
			interrupts = <115 1>;
			interrupt-parent = <&nvic>;
			status = "disabled";
		};

		pinctrl: pin-controller@40230000 {
			compatible = "realtek,rts5918-pinctrl";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x40230000 0x300>;

			/* GPIO0-GPIO7 */
			gpioa: gpio@40230000 {
				index = <0>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230000 0x20>;
				ngpios = <8>;
				interrupts = <0 1>;
			};

			/* GPIO8-GPIO15 */
			gpiob: gpio@40230020 {
				index = <1>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230020 0x20>;
				ngpios = <8>;
				interrupts = <1 1>;
			};

			/* GPIO16-GPIO23 */
			gpioc: gpio@40230040 {
				index = <2>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230040 0x20>;
				ngpios = <8>;
				interrupts = <2 1>;
			};

			/* GPIO24-GPIO31 */
			gpiod: gpio@40230060 {
				index = <3>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230060 0x20>;
				ngpios = <8>;
				interrupts = <3 1>;
			};

			/* GPIO32-GPIO39 */
			gpioe: gpio@40230080 {
				index = <4>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230080 0x20>;
				ngpios = <8>;
				interrupts = <4 1>;
			};

			/* GPIO40-GPIO47 */
			gpiof: gpio@402300A0 {
				index = <5>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x402300A0 0x20>;
				ngpios = <8>;
				interrupts = <5 1>;
			};

			/* GPIO48-GPIO55 */
			gpiog: gpio@402300C0 {
				index = <6>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x402300C0 0x20>;
				ngpios = <8>;
				interrupts = <6 1>;
			};

			/* GPIO56-GPIO63 */
			gpioh: gpio@402300E0 {
				index = <7>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x402300E0 0x20>;
				ngpios = <8>;
				interrupts = <7 1>;
			};

			/* GPIO64-GPIO71 */
			gpioi: gpio@40230100 {
				index = <8>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230100 0x20>;
				ngpios = <8>;
				interrupts = <8 1>;
			};

			/* GPIO72-GPIO79 */
			gpioj: gpio@40230120 {
				index = <9>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230120 0x20>;
				ngpios = <8>;
				interrupts = <9 1>;
			};

			/* GPIO80-GPIO87 */
			gpiok: gpio@40230140 {
				index = <10>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230140 0x20>;
				ngpios = <8>;
				interrupts = <10 1>;
			};

			/* GPIO88-GPIO95 */
			gpiol: gpio@40230160 {
				index = <11>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230160 0x20>;
				ngpios = <8>;
				interrupts = <11 1>;
			};

			/* GPIO96-GPIO103 */
			gpiom: gpio@40230180 {
				index = <12>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230180 0x20>;
				ngpios = <8>;
				interrupts = <12 1>;
			};

			/* GPIO104-GPIO111 */
			gpion: gpio@402301A0 {
				index = <13>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x402301A0 0x20>;
				ngpios = <8>;
				interrupts = <13 1>;
			};

			/* GPIO112-GPIO119 */
			gpioo: gpio@402301C0 {
				index = <14>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x402301C0 0x20>;
				ngpios = <8>;
				interrupts = <14 1>;
			};

			/* GPIO120-GPIO127 */
			gpiop: gpio@402301E0 {
				index = <15>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x402301E0 0x20>;
				ngpios = <8>;
				interrupts = <15 1>;
			};

			/* GPIO128-GPIO135 */
			gpioq: gpio@40230200 {
				index = <16>;
				compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230200 0x20>;
				ngpios = <8>;
				interrupts = <16 1>;
			};

			/* GPIO136-GPIO143 */
			gpior: gpio@40230220 {
				index = <17>;
			compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230220 0x20>;
				ngpios = <8>;
				interrupts = <17 1>;
			};

			/* GPIO144-GPIO151 */
			gpios: gpio@40230240 {
				index = <18>;
			compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230240 0x20>;
				ngpios = <8>;
				interrupts = <18 1>;
			};

			/* GPIO152-GPIO159 */
			gpiot: gpio@40230260 {
				index = <19>;
			compatible = "realtek,rts5918-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x40230260 0x20>;
				ngpios = <8>;
				interrupts = <19 1>;
			};
		};
	};

	swj_port:swj_port{
		compatible = "swj-connector";
		pinctrl-0 = <
					  &jtag_clk_gpio107
					  &jtag_tms_gpio106 >;
		pinctrl-names = "default";
		status = "disabled";
	};

