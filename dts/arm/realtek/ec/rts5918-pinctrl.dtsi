	/* Phase 4.6 — Bison-specific PWM/TACH alternates derived from
	 * datasheet 3.4 GPIO Multiplexing table (pages 17-21 of
	 * RTS5918_preliminary_datasheet_V0.11).
	 *
	 *   GPIO066 F1=PWM06   (CSV: FAN_ON2_VIDEO)
	 *   GPIO108 F1=PWM12   (CSV: FAN_ON_3RD)
	 *   GPIO020 F2=PWM01   (CSV: FAN_ON_CPU,    label already pwm1_gpio020)
	 *   GPIO079 F1=PWM02   (CSV: KBD_BL_PWM,    label already pwm2_gpio079)
	 *   GPIO074 F1=TACHO01 (CSV: FAN_FRQ_CPU)
	 *   GPIO075 F1=TACHO02 (CSV: FAN_FRQ_VIDEO)
	 *   GPIO115 F1=TACHO04 (CSV: FAN_FRQ_3RD)
	 *   GPIO059 F1=LED02   (CSV: LEDLOGO,       LED controller — separate from PWM)
	 *   GPIO138 F1=LED01   (CSV: LEDPWR,        LED controller)
	 */
	/omit-if-no-ref/ pwm6_gpio066: pwm6_gpio066
	{
		pinmux = <REALTEK_RTS5918_PINMUX(66, FUNC1)>;
		output-enable;
	};

