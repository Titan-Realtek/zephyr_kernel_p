	/* Phase 10.9 — PS/2 channel 1 (PS2_DATA01 / PS2_CLK01) routed
	 * through GPIO067 / GPIO068 for Bison TrackPoint.
	 *
	 * Datasheet pin list (page 7):
	 *   D4 = GPIO067/PS2_DATA01  (only 2 functions: GPIO + PS2_DATA01,
	 *                             so PS2_DATA01 is FUNC1)
	 *   D5 = GPIO068/PS2_CLK01   (same — PS2_CLK01 is FUNC1)
	 *
	 * Datasheet §36.2.51 IP_INPUT_SIGNAL_SELECT_REGISTER (offset 0x13C):
	 *   bit 27 (1-bit)    _PS2_DATA1_SEL  0=GPIO017  1=GPIO067
	 *   bit 26:25 (2-bit) _PS2_CLK1_SEL   00=GPIO014 01=GPIO060
	 *                                     10=GPIO068 11=Reserved
	 *
	 * NOTE PS2_CLK1 has 3 alternate physical locations (GPIO014/060/068)
	 * needing a 2-bit selector — different from PS2_CLK2/DATA2 which
	 * are 1-bit. The pin_sel macro args for the 2-bit case use
	 * BIT_LENGTH_2 + value=2 (decimal 2 = binary 10) + shift=25 (low
	 * bit of the 2-bit field).
	 */
	/omit-if-no-ref/ ps2data1_gpio067: ps2data1_gpio067
	{
		pinmux = <REALTEK_RTS5918_PINMUX(67, FUNC1)>;
			input-enable;
			input-schmitt-enable;
	};
	/omit-if-no-ref/ ps2clk1_gpio068: ps2clk1_gpio068
	{
		pinmux = <REALTEK_RTS5918_PINMUX(68, FUNC1)>;
			input-enable;
			input-schmitt-enable;
	};

	/omit-if-no-ref/ ps2data1_gpio067_pin_sel: ps2data1_gpio067_pin_sel
	{
		pinmux = <REALTEK_RTS5918_PINMUX( REALTEK_RTS5918_PIN_SEL(IP_INPUT, BIT_LENGTH_1, 1, 27), 0)>;
			input-enable;
			input-schmitt-enable;
	};

	/omit-if-no-ref/ ps2clk1_gpio068_pin_sel: ps2clk1_gpio068_pin_sel
	{
		pinmux = <REALTEK_RTS5918_PINMUX( REALTEK_RTS5918_PIN_SEL(IP_INPUT, BIT_LENGTH_2, 2, 25), 0)>;
			input-enable;
			input-schmitt-enable;
	};

