# used to remove files from deployment using `git archive`
# git files
.gitattributes export-ignore
.gitignore export-ignore
.mailmap export-ignore

# Tell git to not diff certain files
*.svg -diff

# Tell linguist that generated test pattern files should not be included in the
# language statistics.
*.pat linguist-generated
*.svg linguist-generated

# RTS5918 port: force LF on all Realtek-added/modified files so Windows
# editors (VS Code, Notepad) cannot silently re-introduce CRLF and blow up
# the generated zephyr_patch with phantom whole-file rewrites.
boards/realtek/rts5918_bison/**	text eol=lf
soc/realtek/ec/rts5918/**	text eol=lf
dts/arm/realtek/**	text eol=lf
dts/bindings/**/realtek,rts5918-*.yaml	text eol=lf
drivers/*/Kconfig.rts5918*	text eol=lf
drivers/*/*rts5918*.c	text eol=lf
drivers/*/*rts5918*.h	text eol=lf
drivers/input/*rts5918*.c	text eol=lf
include/zephyr/dt-bindings/**/realtek-*.h	text eol=lf
